# 로그/임시 파일
*.log
*.bak
*.swp

# 빌드 아티팩트 (혹시 추론 모델 만들 때 생성되면?)
dist/
build/

# 탐지 결과 이미지
detect_images/

# 모델 관련 디렉토리
model/
