# VSCode나 IDE 관련
.vscode/
.idea/

# Python 캐시
__pycache__/
*.pyc

# Git 관련
.git
.gitignore

# Docker ignore 자체도 제외 (필요 없으니까)
.dockerignore

# 환경 파일 (복사하고 싶으면 이건 빼세요!)
